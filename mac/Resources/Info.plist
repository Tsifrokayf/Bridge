<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Bridge</string>
    <key>CFBundleDisplayName</key><string>Bridge</string>
    <key>CFBundleIdentifier</key><string>app.bridge.mac</string>
    <key>CFBundleExecutable</key><string>Bridge</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.1</string>
    <key>CFBundleVersion</key><string>2</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSAppleEventsUsageDescription</key><string>Bridge читает адрес открытой вкладки браузера, чтобы открыть её на телефоне.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Bridge сообщает телефону, где находится Mac, когда вы нажимаете «Где Mac».</string>
    <key>NSLocationUsageDescription</key><string>Bridge сообщает телефону, где находится Mac, когда вы нажимаете «Где Mac».</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Bridge находит телефон по Bluetooth, даже когда Mac и телефон не в одной сети.</string>
    <key>NSFocusStatusUsageDescription</key>
    <string>Bridge передаёт на телефон, что на Mac включён режим «Не беспокоить».</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Bridge связывается с вашим телефоном по локальной сети.</string>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Отправить на телефон (Bridge)</string></dict>
            <key>NSMessage</key><string>sendToPhone</string>
            <key>NSPortName</key><string>Bridge</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
                <string>public.file-url</string>
                <string>NSStringPboardType</string>
            </array>
        </dict>
    </array>
    <key>NSBonjourServices</key>
    <array>
        <string>_bridgesync._tcp</string>
    </array>
</dict>
</plist>
